# ─────────────────────────────────────────────────────────────
#  NOVA — environment variables
#  Copy to .env.local for local development, or paste into Vercel
#  → Project → Settings → Environment Variables.
#  Never commit real values.
# ─────────────────────────────────────────────────────────────

# ---- Database (Neon PostgreSQL) ----
# Use the *pooled* connection string (host contains "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ---- Auth ----
# openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"

# ---- Admin seed account ----
# Only used the first time the database is seeded. Set before the first deploy.
ADMIN_EMAIL="you@yourstore.com"
ADMIN_PASSWORD="a-strong-password-at-least-12-chars"

# ---- Transactional email (SMTP, e.g. Gmail app password) ----
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-16-character-app-password"
MAIL_FROM_NAME="NOVA"
MAIL_FROM_EMAIL="you@gmail.com"
ORDER_NOTIFICATION_EMAIL="you@gmail.com"

# ---- S3-compatible object storage for uploads (optional) ----
# Without these, uploads fall back to the local /uploads folder.
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-2"
S3_BUCKET=""

# ---- Store ----
NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"
# Exchange-rate provider used by the automatic currency refresh (optional)
EXCHANGE_RATE_API="https://open.er-api.com/v6/latest"
