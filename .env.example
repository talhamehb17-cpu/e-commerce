# ─────────────────────────────────────────────────────────────
#  NOVA — environment variables
#  Copy to .env.local for local development, or paste into Vercel
#  → Project → Settings → Environment Variables.
#  Never commit real values.
# ─────────────────────────────────────────────────────────────

# ---- Database (Neon PostgreSQL) ----
# Use the *pooled* connection string (host contains "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ---- Admin seed account ----
# Only used the first time the database is seeded. Set before the first deploy.
ADMIN_EMAIL="you@yourstore.com"
ADMIN_PASSWORD="a-strong-password-at-least-12-chars"

# ---- Transactional email (SMTP, e.g. Gmail app password) ----
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-16-character-app-password"
# Required only for SMTP credentials saved through the owner-only admin Email Configuration page.
# Generate a dedicated 32-byte key (base64 or 64-character hex); never reuse SMTP_PASS.
SMTP_CREDENTIALS_KEY=""
MAIL_FROM_NAME="NOVA"
MAIL_FROM_EMAIL="you@gmail.com"
ORDER_NOTIFICATION_EMAIL="you@gmail.com"

# ---- S3-compatible object storage for uploads (optional) ----
# All four values are required to enable uploads; otherwise uploads are unavailable.
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-2"
S3_BUCKET=""

# ---- Store ----
NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"
# Exchange-rate provider used by automatic currency refresh (optional)
EXCHANGE_RATE_API="https://open.er-api.com/v6/latest"

# Build/development controls (optional)
# Set to 0 to skip DB migration/seed/sync during a build; never set this if the
# build is responsible for applying schema changes to its target database.
DEPLOY_DB="1"
# Override the local PGlite wire-protocol port (default 55432; local scripts only).
PGLITE_PORT="55432"
