{
  "name": "nova-commerce",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/deploy-db.mjs && next build",
    "start": "next start -p 3000",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs",
    "db:deploy": "node scripts/migrate.mjs && node scripts/seed.mjs",
    "postinstall": "echo skip",
    "build:local": "DEPLOY_DB=0 next build"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "jose": "^6.2.17",
    "lucide-react": "^1.72.0",
    "next": "^15.5.29",
    "nodemailer": "^10.5.0",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19"
  },
  "engines": {
    "node": ">=20"
  }
}